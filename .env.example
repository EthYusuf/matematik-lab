# docker compose için örnek ortam değişkenleri — kopyala: cp .env.example .env

# Üretimde mutlaka uzun ve rastgele bir değer kullan:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
MATLAB_SECRET_KEY=buraya-rastgele-uzun-bir-anahtar-yaz

POSTGRES_PASSWORD=matlab-dev-password

# HTTPS arkasında yayınlıyorsan true yap (yenileme çerezi yalnızca HTTPS ile gönderilir)
MATLAB_COOKIE_SECURE=false
